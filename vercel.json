{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/search.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/opensearch.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/opensearchdescription+xml" }
      ]
    }
  ]
}
